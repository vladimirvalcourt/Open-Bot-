{
  "name": "openmausbot",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:check": "node scripts/security-check.mjs",
    "eval:trust": "node scripts/run-trust-evals.mjs",
    "commercial:check": "pnpm typecheck && pnpm test && pnpm security:check && pnpm eval:trust && pnpm build",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-composio.mjs",
    "build:speech": "swiftc -O electron/resources/speech-helper.swift -o electron/resources/speech-helper",
    "build:keychain": "swiftc -O electron/resources/keychain-helper.swift -o electron/resources/keychain-helper",
    "build:updater": "node scripts/bundle-updater.mjs",
    "build:cua": "node scripts/prepare-cua-driver.mjs",
    "build:gh": "node scripts/prepare-github-cli.mjs",
    "package": "pnpm build && pnpm build:server && pnpm build:speech && pnpm build:keychain && pnpm build:updater && pnpm build:cua && pnpm build:gh && electron-builder --mac --publish never",
    "verify:mac": "node scripts/verify-mac-app.mjs"
  },
  "dependencies": {
    "@composio/core": "^0.16.0",
    "@phosphor-icons/react": "^2.1.10",
    "@trycua/cua-driver": "^0.19.3",
    "clsx": "^2.1.1",
    "posthog-js": "^1.415.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
